<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyect.chagas_dengue.ControladorPrincipal">

    <TabPane fx:id="mainTabPane" styleClass="custom-tab-pane" tabClosingPolicy="UNAVAILABLE">
        <Tab fx:id="tabMenu" styleClass="menu-tab" text="Menu">
            <StackPane style="-fx-background-color: white;">
                <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 50;">
                    <Label styleClass="content-label" text="Bienvenido a Chagas/Dengue" />
                    <!-- Logo desde archivo -->
                    <ImageView fitHeight="200" fitWidth="200" preserveRatio="true">
                        <Image url="@animal.png" />
                    </ImageView>
                </VBox>
            </StackPane>
        </Tab>
        <Tab styleClass="viaje-tab" text="Viaje">
            <VBox>
                <TabPane fx:id="tabPanePrepViaje" styleClass="custom-subtab-pane" tabClosingPolicy="UNAVAILABLE">

                    <!-- ######################## Destino ##################### -->

                    <Tab fx:id="tabDestPrepViaje" styleClass="submenu-tab" text="Destino">
                        <StackPane style="-fx-background-color: white;">
                            <Pane>
                                <children>
                                    <Label layoutX="197.0" layoutY="162.0" text="Destino:">
                                        <font>
                                            <Font size="18.0" />
                                        </font>
                                    </Label>
                                    <Label layoutX="212.0" layoutY="229.0" text="Fecha:">
                                        <font>
                                            <Font size="18.0" />
                                        </font>
                                    </Label>
                                    <DatePicker fx:id="datePnDestPrepViaje" layoutX="277.0" layoutY="230.0" />
                                    <Button fx:id="btnSigPnDestPrepViaje" layoutX="358.0" layoutY="411.0" mnemonicParsing="false" onAction="#onSiguiente" text="Siguiente">
                                        <font>
                                            <Font size="18.0" />
                                        </font>
                                    </Button>
                                    <Label alignment="CENTER" layoutX="257.0" layoutY="34.0" prefHeight="90.0" prefWidth="301.0" text="Seleccione destino, fecha y tipo de viaje" textAlignment="CENTER" wrapText="true">
                                        <font>
                                            <Font size="24.0" />
                                        </font>
                                    </Label>
                                    <Label layoutX="212.0" layoutY="303.0" text="Tipo:">
                                        <font>
                                            <Font size="18.0" />
                                        </font>
                                    </Label>
                                    <RadioButton fx:id="radbtnDiaPaneDestPrepViaje" layoutX="277.0" layoutY="303.0" mnemonicParsing="false" text="Diario">
                                        <font>
                                            <Font size="18.0" />
                                        </font>
                                        <toggleGroup>
                                            <ToggleGroup fx:id="tipoViajeOpcs" />
                                        </toggleGroup>
                                    </RadioButton>
                                    <RadioButton fx:id="radbtnBarrPaneDestPrepViaje" layoutX="434.0" layoutY="303.0" mnemonicParsing="false" text="Barrido" toggleGroup="$tipoViajeOpcs">
                                        <font>
                                            <Font size="18.0" />
                                        </font>
                                    </RadioButton>
                                    <ChoiceBox fx:id="chBoxDestPnDestPrepViaje" layoutX="277.0" layoutY="163.0" prefWidth="150.0" />
                                </children>
                            </Pane>
                        </StackPane>
                    </Tab>

                    <!-- ######################## Elementos ##################### -->

                    <Tab fx:id="tabElmsPrepViaje" styleClass="submenu-tab" text="Elementos">
                        <content>
                            <!-- ScrollPane para permitir desplazamiento vertical -->
                            <ScrollPane fx:id="scrPaneElmsPrepViaje" fitToWidth="true" hbarPolicy="NEVER" pannable="true" vbarPolicy="AS_NEEDED">
                                <AnchorPane fx:id="anchorElementos" prefHeight="560.0" prefWidth="800.0" style="-fx-background-color: white;">

                                    <children>
                                        <!-- Contenedor principal para alinear verticalmente -->
                                        <VBox alignment="CENTER" layoutY="19.0" prefHeight="541.0" prefWidth="800.0" spacing="10" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="19.0">

                                            <!-- Labels arriba del Accordion -->
                                            <HBox spacing="20" />
                                            <Label text="Seleccione una pestaña para añadir elementos">
                                                <font>
                                                    <Font size="19.0" />
                                                </font>
                                            </Label>

                                            <!-- Accordion ocupa todo el espacio restante -->
                                            <Accordion fx:id="accordion" prefHeight="406.0" prefWidth="800.0" VBox.vgrow="ALWAYS">

                                                <panes>
                                                    <!-- Elementos de seguridad -->
                                                    <TitledPane animated="false" expanded="false" text="Elementos de seguridad">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Elementos de seguridad">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableElementos" prefHeight="200" prefWidth="650">
                                                                    <columns>

                                                                        <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                                                                        <TableColumn fx:id="colDescripcion" prefWidth="150" text="Descripción" />

                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10" />
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>

                                                    <!-- Productos Químicos -->
                                                    <TitledPane animated="false" text="Productos Químicos">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Producto(s) químico(s)">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableQuimicos" prefHeight="200" prefWidth="650">
                                                                    <columns>
                                                                        <TableColumn fx:id="colProdCodigo" prefWidth="100" text="Código" />
                                                                        <TableColumn fx:id="colProdNombre" prefWidth="150" text="Nombre" />
                                                                        <TableColumn fx:id="colProdMarca" prefWidth="150" text="Marca" />
                                                                        <TableColumn fx:id="colProdPresentacion" prefWidth="150" text="Presentación (L)" />
                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10">
                                                                    <Button fx:id="btnAñadirProducto" onAction="#onAñadirProducto" prefWidth="100" text="Agregar..." />
                                                                    <Button fx:id="btnEditarQuimicos" onAction="#onEditarQuimicos" prefWidth="100" text="Editar..." />
                                                                </HBox>
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>

                                                    <!-- Camionetas -->
                                                    <TitledPane animated="false" expanded="false" text="Camionetas">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Camioneta(s)">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableCamionetas" prefHeight="200" prefWidth="650">
                                                                    <columns>
                                                                        <TableColumn fx:id="colCamionetaCodigo" prefWidth="100" text="Código" />
                                                                        <TableColumn fx:id="colCamionetaPatente" prefWidth="150" text="Patente" />
                                                                        <TableColumn fx:id="colCamionetaEstado" prefWidth="150" text="Estado" />
                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10">
                                                                    <Button fx:id="btnAñadirCamioneta" onAction="#onAñadirCamioneta" prefWidth="100" text="Agregar..." />
                                                                    <Button fx:id="btnEditarCamionetas" onAction="#onEditarCamionetas" prefWidth="100" text="Editar..." />
                                                                </HBox>
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>

                                                    <!-- Maquinas -->
                                                    <TitledPane animated="false" expanded="false" prefHeight="343.0" prefWidth="800.0" text="Maquinas">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Máquina(s)">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableMaquinas" prefHeight="200" prefWidth="650">
                                                                    <columns>
                                                                        <TableColumn fx:id="colMaqCodigo" prefWidth="100" text="Código" />
                                                                        <TableColumn fx:id="colMaqMarca" prefWidth="150" text="Marca" />
                                                                        <TableColumn fx:id="colMaqModelo" prefWidth="150" text="Modelo" />
                                                                        <TableColumn fx:id="colMaqTipo" prefWidth="150" text="Tipo" />
                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10">
                                                                    <Button fx:id="btnAñadirMaquina" onAction="#onAñadirMaquina" prefWidth="100" text="Agregar..." />
                                                                    <Button fx:id="btnEditarMaquinas" onAction="#onEditarMaquinas" prefWidth="100" text="Editar..." />
                                                                </HBox>
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>
                                                </panes>
                                            </Accordion>
                                            <Button fx:id="btnGuardarElementos" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onGuardar" text="Guardar" />
                                        </VBox>
                                    </children>
                                </AnchorPane>

                            </ScrollPane>
                        </content>
                    </Tab>

                    <!-- ######################## Listar ##################### -->

                    <Tab fx:id="tabListPrepViaje" styleClass="submenu-tab" text="Listar">
                        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20;">
                            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #363535;" text="Lista de Elementos del Viaje (Ejemplo)" />

                            <!-- Lista de objetos -->
                            <VBox fx:id="listaContainer" spacing="8" styleClass="ListarCont">
                            </VBox>

                            <!-- Botón para generar PDF -->
                            <HBox alignment="CENTER" spacing="20">
                                <Button fx:id="btnGenerarPDF" onAction="#generarPDF" styleClass="Btngenerar" text="Generar PDF" />
                                <Button fx:id="btnActualizarLista" onAction="#actualizarLista" styleClass="BtnActualizar" text="Actualizar Lista" />
                            </HBox>

                            <!-- Mensaje de confirmación -->
                            <Label fx:id="lblMensajePDF" style="-fx-font-size: 14px; -fx-text-fill: #28a745;" text="" />
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </Tab>
    </TabPane>

</VBox>
