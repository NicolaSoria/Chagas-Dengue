<VBox stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <TabPane fx:id="mainTabPane" styleClass="custom-tab-pane" tabClosingPolicy="UNAVAILABLE">
        <Tab styleClass="menu-tab" text="Menu">
            <StackPane style="-fx-background-color: white;">
                <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 50;">
                    <Label styleClass="content-label" text="Bienvenido a Chagas/Dengue" />
                    <!-- Logo desde archivo -->
                    <ImageView fitHeight="200" fitWidth="200" preserveRatio="true">
                        <Image url="@animal.png" />
                    </ImageView>
                </VBox>
            </StackPane>
        </Tab>
        <Tab styleClass="viaje-tab" text="Viaje">
            <VBox>
                <TabPane styleClass="custom-subtab-pane" tabClosingPolicy="UNAVAILABLE">
                    <Tab styleClass="submenu-tab" text="Destino">
                        <StackPane style="-fx-background-color: white;">
                            <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 50;">
                                <Label styleClass="content-label" text="Ventana de destino y fecha" />
                            </VBox>
                        </StackPane>
                    </Tab>
                    <Tab styleClass="submenu-tab" text="Elementos">
                        <content>
                            <!-- ScrollPane para permitir desplazamiento vertical -->
                            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" pannable="true" vbarPolicy="AS_NEEDED">
                                <AnchorPane fx:id="anchorElementos" prefHeight="560.0" prefWidth="800.0" style="-fx-background-color: white;">

                                    <children>
                                        <!-- Contenedor principal para alinear verticalmente -->
                                        <VBox spacing="10" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                                            <!-- Labels arriba del Accordion -->
                                            <HBox alignment="CENTER_LEFT" spacing="20">
                                                <Label prefHeight="39.0" prefWidth="78.0" text="  Viaje">
                                                    <font>
                                                        <Font size="27" />
                                                    </font>
                                                </Label>
                                                <Label text="ViajeID">
                                                    <font>
                                                        <Font name="System Bold" size="27" />
                                                    </font>
                                                </Label>
                                            </HBox>

                                            <!-- Accordion ocupa todo el espacio restante -->
                                            <Accordion fx:id="accordion" VBox.vgrow="ALWAYS">

                                                <panes>
                                                    <!-- Elementos de seguridad -->
                                                    <TitledPane animated="false" text="Elementos de seguridad">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Elementos de seguridad">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableSeguridad" prefHeight="200" prefWidth="650">
                                                                    <columns>
                                                                        <TableColumn prefWidth="75" text="C1" />
                                                                        <TableColumn prefWidth="75" text="C2" />
                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10">
                                                                    <Button prefWidth="100" text="Agregar..." />
                                                                    <Button prefWidth="100" text="Editar..." />
                                                                </HBox>
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>

                                                    <!-- Productos Químicos -->
                                                    <TitledPane animated="false" text="Productos Químicos">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Producto(s) químico(s)">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableQuimicos" prefHeight="200" prefWidth="650">
                                                                    <columns>
                                                                        <TableColumn prefWidth="75" text="C1" />
                                                                        <TableColumn prefWidth="75" text="C2" />
                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10">
                                                                    <Button prefWidth="100" text="Agregar..." />
                                                                    <Button prefWidth="100" text="Editar..." />
                                                                </HBox>
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>

                                                    <!-- Camionetas -->
                                                    <TitledPane animated="false" text="Camionetas">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Camioneta(s)">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableCamionetas" prefHeight="200" prefWidth="650">
                                                                    <columns>
                                                                        <TableColumn prefWidth="75" text="C1" />
                                                                        <TableColumn prefWidth="75" text="C2" />
                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10">
                                                                    <Button prefWidth="100" text="Agregar..." />
                                                                    <Button prefWidth="100" text="Editar..." />
                                                                </HBox>
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>

                                                    <!-- Maquinas -->
                                                    <TitledPane animated="false" text="Maquinas">
                                                        <content>
                                                            <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                <Label text="Máquina(s)">
                                                                    <font>
                                                                        <Font size="20" />
                                                                    </font>
                                                                </Label>

                                                                <TableView fx:id="tableMaquinas" prefHeight="200" prefWidth="650">
                                                                    <columns>
                                                                        <TableColumn prefWidth="75" text="C1" />
                                                                        <TableColumn prefWidth="75" text="C2" />
                                                                    </columns>
                                                                </TableView>

                                                                <HBox alignment="CENTER" spacing="10">
                                                                    <Button prefWidth="100" text="Agregar..." />
                                                                    <Button prefWidth="100" text="Editar..." />
                                                                </HBox>
                                                            </VBox>
                                                        </content>
                                                    </TitledPane>
                                                </panes>
                                            </Accordion>
                                 <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" prefHeight="44.0" prefWidth="812.0" text="Guardar" />
                                        </VBox>
                                    </children>
                                </AnchorPane>

