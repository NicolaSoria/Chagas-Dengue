<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyect.chagas_dengue.ControladorPrincipal">

    <TabPane fx:id="mainTabPane" styleClass="custom-tab-pane" tabClosingPolicy="UNAVAILABLE">
        <Tab fx:id="tabMenu" styleClass="menu-tab" text="Menu">
            <StackPane style="-fx-background-color: white;">
                <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 50;">
                    <Label styleClass="content-label" text="Bienvenido a Chagas/Dengue" />
                    <!-- Logo desde archivo -->
                    <ImageView fitHeight="200" fitWidth="200" preserveRatio="true">
                        <Image url="@animal.png" />
                    </ImageView>
                </VBox>
            </StackPane>
        </Tab>
        <Tab styleClass="viaje-tab" text="Viaje">
            <VBox>
                <TabPane fx:id="tabPanePrepViaje" styleClass="custom-subtab-pane" tabClosingPolicy="UNAVAILABLE">
                    <Tab fx:id="tabDestPrepViaje" styleClass="submenu-tab" text="Destino">
                        <StackPane style="-fx-background-color: white;">
                     <Pane>
                        <children>
                           <Label layoutX="197.0" layoutY="162.0" text="Destino:">
                              <font>
                                 <Font size="18.0" />
                              </font>
                           </Label>
                           <Label layoutX="212.0" layoutY="229.0" text="Fecha:">
                              <font>
                                 <Font size="18.0" />
                              </font>
                           </Label>
                           <DatePicker fx:id="datePnDestPrepViaje" layoutX="277.0" layoutY="230.0" />
                           <Button fx:id="btnSigPnDestPrepViaje" layoutX="358.0" layoutY="411.0" mnemonicParsing="false" onAction="#mostrarPanelElementos" text="Siguiente">
                              <font>
                                 <Font size="18.0" />
                              </font>
                           </Button>
                           <Label alignment="CENTER" layoutX="257.0" layoutY="34.0" prefHeight="90.0" prefWidth="301.0" text="Seleccione destino, fecha y tipo de viaje" textAlignment="CENTER" wrapText="true">
                              <font>
                                 <Font size="24.0" />
                              </font>
                           </Label>
                           <Label layoutX="212.0" layoutY="303.0" text="Tipo:">
                              <font>
                                 <Font size="18.0" />
                              </font>
                           </Label>
                           <RadioButton fx:id="radbtnDiaPaneDestPrepViaje" layoutX="277.0" layoutY="303.0" mnemonicParsing="false" text="Diario">
                              <font>
                                 <Font size="18.0" />
                              </font>
                              <toggleGroup>
                                 <ToggleGroup fx:id="tipoViajeOpcs" />
                              </toggleGroup>
                           </RadioButton>
                           <RadioButton fx:id="radbtnBarrPaneDestPrepViaje" layoutX="434.0" layoutY="303.0" mnemonicParsing="false" text="Barrido" toggleGroup="$tipoViajeOpcs">
                              <font>
                                 <Font size="18.0" />
                              </font>
                           </RadioButton>
                           <ChoiceBox fx:id="chBoxDestPnDestPrepViaje" layoutX="277.0" layoutY="163.0" prefWidth="150.0" />
                        </children>
                     </Pane>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="tabElmsPrepViaje" styleClass="submenu-tab" text="Elementos">
                        <content>
                            <!-- ScrollPane para permitir desplazamiento vertical -->
                            <ScrollPane fx:id="scrPaneElmsPrepViaje" fitToWidth="true" hbarPolicy="NEVER" pannable="true" vbarPolicy="AS_NEEDED">
                                <AnchorPane fx:id="anchorElementos" prefHeight="560.0" prefWidth="800.0" style="-fx-background-color: white;">

                                    <children>
                                        <!-- Contenedor principal para alinear verticalmente -->
                                        <VBox alignment="CENTER" spacing="10" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                                            <!-- Labels arriba del Accordion -->
                                            <HBox spacing="20">
                                                <Label prefHeight="39.0" prefWidth="78.0" text="  Viaje">
                                                    <font>
                                                        <Font size="27" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblviajeIDPnElmsPrepViaje" text="ViajeID">
                                                    <font>
                                                        <Font name="System Bold" size="27" />
                                                    </font>
                                                </Label>
                                            </HBox>
                                 <Label text="Seleccione una pestaña para añadir elementos">
                                    <font>
                                       <Font size="19.0" />
                                    </font>
                                 </Label>

                                            <!-- Accordion ocupa todo el espacio restante -->
                                            <Accordion fx:id="accordion" VBox.vgrow="ALWAYS">

                                                <panes>
                                                    <!-- Elementos de seguridad -->
                                                    <TitledPane animated="false" text="Elementos de seguridad">
