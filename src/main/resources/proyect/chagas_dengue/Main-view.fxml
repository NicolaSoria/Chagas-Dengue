<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>


<?import javafx.scene.text.Font?>
<BorderPane stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyect.chagas_dengue.ControladorPrincipal">

        <center>
            <TabPane fx:id="mainTabPane" styleClass="custom-tab-pane" tabClosingPolicy="UNAVAILABLE">
                <tabs>
                    <Tab fx:id="tabMenu" styleClass="menu-tab" text="Menu">
                        <StackPane style="-fx-background-color: white;">
                            <VBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-padding: 50;">
                                <Label styleClass="content-label" text="Bienvenido a Chagas/Dengue" />
                                <ImageView fitHeight="200" fitWidth="200" preserveRatio="true">
                                    <Image url="@animal.png" />
                                </ImageView>
                            </VBox>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="tabPanificar" styleClass="viaje-tab" text="Planificar">
                        <VBox>
                            <TabPane fx:id="tabPanePrepViaje" styleClass="custom-subtab-pane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

                                                         <!-- Destino-->

                                <Tab fx:id="tabDestPrepViaje" styleClass="submenu-tab" text="Destino">
                                    <StackPane style="-fx-background-color: white;">
                                        <Pane>
                                            <children>
                                                <Label layoutX="206.0" layoutY="162.0" text="Fecha:">
                                                    <font>
                                                        <Font size="18.0" />
                                                    </font>
                                                </Label>
                                                <DatePicker fx:id="datePnDestPrepViaje" layoutX="277.0" layoutY="163.0" />
                                                <Button fx:id="btnSigPnDestPrepViaje" layoutX="351.0" layoutY="439.0" mnemonicParsing="false" onAction="#onSiguiente" prefHeight="40.0" prefWidth="100.0" text="Siguiente">
                                                    <font>
                                                        <Font size="18.0" />
                                                    </font>
                                                </Button>
                                                <Label alignment="CENTER" layoutY="34.0" prefHeight="90.0" prefWidth="800.0" text="Seleccione destino, fecha y tipo de viaje" textAlignment="CENTER" wrapText="true">
                                                    <font>
                                                        <Font size="24.0" />
                                                    </font>
                                                </Label>
                                                <Label layoutX="206.0" layoutY="229.0" text="Tipo:">
                                                    <font>
                                                        <Font size="18.0" />
                                                    </font>
                                                </Label>
                                                <RadioButton fx:id="radbtnDiaPaneDestPrepViaje" layoutX="277.0" layoutY="229.0" mnemonicParsing="false" text="Diario">
                                                    <font>
                                                        <Font size="18.0" />
                                                    </font>
                                                    <toggleGroup>
                                                        <ToggleGroup fx:id="tipoViajeOpcs" />
                                                    </toggleGroup>
                                                </RadioButton>
                                                <RadioButton fx:id="radbtnBarrPaneDestPrepViaje" layoutX="420.0" layoutY="229.0" mnemonicParsing="false" text="Barrido" toggleGroup="$tipoViajeOpcs">
                                                    <font>
                                                        <Font size="18.0" />
                                                    </font>
                                                </RadioButton>
                                                <Label layoutX="203.0" layoutY="290.0" text="Destino(s):">
                                                    <font>
                                                        <Font size="18.0" />
                                                    </font>
                                                </Label>
                                                <ChoiceBox fx:id="chBoxDestPnDestPrepViaje" layoutX="301.0" layoutY="291.0" prefWidth="150.0" />
                                                <ChoiceBox fx:id="chBoxDestPnDestPrepViaje2" layoutX="301.0" layoutY="338.0" prefWidth="150.0" />
                                                <ChoiceBox fx:id="chBoxDestPnDestPrepViaje3" layoutX="301.0" layoutY="383.0" prefWidth="150.0" />
                                 <Button fx:id="btnRegistrarViajePaneListar" layoutX="134.0" layoutY="439.0" mnemonicParsing="false" onAction="#ingresarViaje" prefHeight="40.0" prefWidth="152.0" text="Registrar viaje">
                                    <font>
                                       <Font size="18.0" />
                                    </font>
                                 </Button>
                                            </children>
                                        </Pane>
                                    </StackPane>
                                </Tab>

                                                                <!-- Asignar Elementos-->

                                <Tab fx:id="tabElmsPrepViaje" styleClass="submenu-tab" text="Recursos">
                                    <content>
                                        <ScrollPane fx:id="scrPaneElmsPrepViaje" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" pannable="true" vbarPolicy="AS_NEEDED">
                                            <AnchorPane fx:id="anchorElementos" style="-fx-background-color: white; -fx-padding: 0 0 350 0 ">
                                                <children>
                                                    <VBox alignment="CENTER" spacing="10" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="10.0">

                                                        <HBox spacing="20" />
                                                        <Label text="Seleccione una pestaña para añadir recursos">
                                                            <font>
                                                                <Font size="19.0" />
                                                            </font>
                                                        </Label>

                                                        <Accordion fx:id="accordion" prefHeight="406.0" prefWidth="800.0" VBox.vgrow="ALWAYS">

                                                            <panes>

                                                                <TitledPane text="Empleados">
                                                                    <content>
                                                                        <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                            <Label text="Empleados">
                                                                                <font>
                                                                                    <Font size="20" />
                                                                                </font>
                                                                            </Label>

                                                                            <TableView fx:id="tableEmpleados" prefHeight="200" prefWidth="650">
                                                                                <columns>
                                                                                    <TableColumn fx:id="colEmpleadoCod" prefWidth="100" text="Código" />
                                                                                    <TableColumn fx:id="colEmpleadoNombre" prefWidth="150" text="Nombre" />
                                                                                    <TableColumn fx:id="colEmpleadoDNI" prefWidth="150" text="DNI" />

                                                                                </columns>
                                                                            </TableView>

                                                                            <HBox alignment="CENTER" spacing="10">
                                                                                    <Button fx:id="btnAñadirEmpleado" onAction="#onAñadirEmpleados" prefWidth="100" text="Agregar..." />
                                                                                    <Button fx:id="btnEditarEmpleados" onAction="#onEditarEmpleados" prefWidth="100" text="Editar..." />
                                                                            </HBox>
                                                                        </VBox>
                                                                    </content>
                                                                </TitledPane>


                                                                <TitledPane text="Elementos de seguridad">
                                                                    <content>
                                                                        <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                            <Label text="Elementos de seguridad">
                                                                                <font>
                                                                                    <Font size="20" />
                                                                                </font>
                                                                            </Label>

                                                                            <TableView fx:id="tableElementos" prefHeight="200" prefWidth="650">
                                                                                <columns>

                                                                                    <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                                                                                    <TableColumn fx:id="colDescripcion" prefWidth="266.0" text="Descripción" />

                                                                                </columns>
                                                                            </TableView>

                                                                            <HBox alignment="CENTER" spacing="10" />
                                                                        </VBox>
                                                                    </content>
                                                                </TitledPane>

                                                                <TitledPane text="Productos Químicos">
                                                                    <content>
                                                                        <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                            <Label text="Producto(s) químico(s)">
                                                                                <font>
                                                                                    <Font size="20" />
                                                                                </font>
                                                                            </Label>

                                                                            <TableView fx:id="tableQuimicos" prefHeight="200" prefWidth="650">
                                                                                <columns>
                                                                                    <TableColumn fx:id="colProdCodigo" prefWidth="100" text="Código" />
                                                                                    <TableColumn fx:id="colProdNombre" prefWidth="150" text="Nombre" />
                                                                                    <TableColumn fx:id="colProdMarca" prefWidth="150" text="Marca" />
                                                                                    <TableColumn fx:id="colProdPresentacion" prefWidth="150" text="Presentación (L)" />
                                                                                </columns>
                                                                            </TableView>

                                                                            <HBox alignment="CENTER" spacing="10">
                                                                                <Button fx:id="btnAñadirProducto" onAction="#onAñadirProducto" prefWidth="100" text="Agregar..." />
                                                                                <Button fx:id="btnEditarQuimicos" onAction="#onEditarQuimicos" prefWidth="100" text="Editar..." />
                                                                            </HBox>
                                                                        </VBox>
                                                                    </content>
                                                                </TitledPane>

                                                                <TitledPane expanded="false" text="Camionetas">
                                                                    <content>
                                                                        <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                            <Label text="Camioneta(s)">
                                                                                <font>
                                                                                    <Font size="20" />
                                                                                </font>
                                                                            </Label>

                                                                            <TableView fx:id="tableCamionetas" prefHeight="200" prefWidth="650">
                                                                                <columns>
                                                                                    <TableColumn fx:id="colCamionetaCodigo" prefWidth="100" text="Código" />
                                                                                    <TableColumn fx:id="colCamionetaPatente" prefWidth="150" text="Patente" />
                                                                                    <TableColumn fx:id="colCamionetaEstado" prefWidth="150" text="Estado" />
                                                                                </columns>
                                                                            </TableView>

                                                                            <HBox alignment="CENTER" spacing="10">
                                                                                <Button fx:id="btnAñadirCamioneta" onAction="#onAñadirCamioneta" prefWidth="100" text="Agregar..." />
                                                                                <Button fx:id="btnEditarCamionetas" onAction="#onEditarCamionetas" prefWidth="100" text="Editar..." />
                                                                            </HBox>
                                                                        </VBox>
                                                                    </content>
                                                                </TitledPane>

                                                                <TitledPane expanded="false" prefHeight="343.0" prefWidth="800.0" text="Maquinas">
                                                                    <content>
                                                                        <VBox alignment="TOP_CENTER" prefHeight="350" spacing="10">
                                                                            <Label text="Máquina(s)">
                                                                                <font>
                                                                                    <Font size="20" />
                                                                                </font>
                                                                            </Label>

                                                                            <TableView fx:id="tableMaquinas" prefHeight="200" prefWidth="650">
                                                                                <columns>
                                                                                    <TableColumn fx:id="colMaqCodigo" prefWidth="100" text="Código" />
                                                                                    <TableColumn fx:id="colMaqMarca" prefWidth="150" text="Marca" />
                                                                                    <TableColumn fx:id="colMaqModelo" prefWidth="150" text="Modelo" />
                                                                                    <TableColumn fx:id="colMaqTipo" prefWidth="150" text="Tipo" />
                                                                                </columns>
                                                                            </TableView>

                                                                            <HBox alignment="CENTER" spacing="10">
                                                                                <Button fx:id="btnAñadirMaquina" onAction="#onAñadirMaquina" prefWidth="100" text="Agregar..." />
                                                                                <Button fx:id="btnEditarMaquinas" onAction="#onEditarMaquinas" prefWidth="100" text="Editar..." />
                                                                            </HBox>
                                                                        </VBox>
                                                                    </content>
                                                                </TitledPane>
                                                            </panes>
                                                        </Accordion>
                                                        <Button fx:id="btnGuardarElementos" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onGuardar" text="Guardar" />
                                                    </VBox>
                                                </children>

                                            </AnchorPane>
                                        </ScrollPane>
                                    </content>
                                </Tab>

                                                                    <!-- Listar-->

                                <Tab styleClass="submenu-tab" text="Listar">
                                    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20;">
                                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #363535;" text="Lista de Recursos del Viaje" />

                                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
                                            <VBox fx:id="listaContainer" spacing="8" styleClass="ListarCont">
                                                <!-- Los labels se generarán automáticamente desde el controlador -->
                                            </VBox>
                                        </ScrollPane>

                                        <HBox alignment="CENTER" prefHeight="29.0" prefWidth="760.0" spacing="20">
                                            <Button fx:id="btnGenerarPDF" onAction="#generarPDF" text="Generar PDF" />
                                            <Button fx:id="btnActualizarLista" onAction="#actualizarLista" text="Actualizar Lista" />
                                        </HBox>

                                        <Label fx:id="lblMensajePDF" style="-fx-font-size: 14px; -fx-text-fill: #28a745;" text="" />
                           <HBox alignment="CENTER" prefHeight="29.0" prefWidth="760.0" />
                                    </VBox>
                                </Tab>
                            </TabPane>
                        </VBox>
                    </Tab>
                    <!-- Finalizar Viaje-->
                    <Tab fx:id="tabFin" styleClass="finalizar-tab" text="Finalizar">
                    <Tab styleClass="finalizar-tab" text="Finalizar">
                        <StackPane style="-fx-background-color: white;">
                            <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20;">
                                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #363535;" text="Lista de Recursos del Viaje" />

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
                                    <VBox fx:id="listaFinalizar" spacing="8" styleClass="ListarCont">
                                        <!-- Los labels se generarán automáticamente desde el controlador -->
                                    </VBox>
                                </ScrollPane>
                            </VBox>
                        </StackPane>
                    </Tab>

                    <!-- Consultar Viaje-->
                    <Tab styleClass="consultar-tab" text="Consultar">
                        <StackPane style="-fx-background-color: white;">
                    <Tab fx:id="tabConsultar" styleClass="consultar-tab" text="Consultar">
                        <StackPane style="-fx-background-color: white;">
<!--                            <fx:include source="Consultar.fxml" fx:id="consultarController" />-->


                        </StackPane>
                    </Tab>
                </tabs>


            </TabPane>
        </center>

        <bottom>
            <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER_RIGHT">
                <Button fx:id="btnCancelar" text="Cancelar" onAction="#onCancelar" styleClass="btn-cancelar" />
                <padding>
                    <Insets bottom="10.0" right="10.0" top="10.0" />
                </padding>
            </HBox>
        </bottom>

    </BorderPane>
