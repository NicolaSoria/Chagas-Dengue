<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="proyect.chagas_dengue.interfaz.ConsultarController">
<padding>
    <javafx.geometry.Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
</padding>

<top>
    <VBox spacing="10.0" BorderPane.alignment="CENTER">
        <Label styleClass="titulo" text="Consulta de Viajes" />
        <Separator />
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Buscar por Destino/Código:" textFill="WHITE" />
            <TextField fx:id="txtBuscador" prefWidth="200.0" promptText="Ingrese texto de búsqueda..." />

            <Separator orientation="VERTICAL" />

            <Label text="Filtrar por Fecha:" textFill="WHITE" />
            <DatePicker fx:id="dpFechaFiltro" promptText="Seleccione fecha" />

            <Label text="Estado:" textFill="WHITE" />
            <ComboBox fx:id="cbEstadoFiltro" prefWidth="150.0" promptText="Seleccione estado" />
        </HBox>
        <Separator />
    </VBox>
</top>

<center>
    <TableView fx:id="tableViajes" prefHeight="400.0" prefWidth="600.0" BorderPane.alignment="CENTER">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Código" />
            <TableColumn fx:id="colDestino" prefWidth="200.0" text="Destino(s)" />
            <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</center>

<bottom>
    <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER_RIGHT">
        <Button fx:id="btnDetalle" disable="true" text="Ver Detalles..." />
    </HBox>
</bottom>
</BorderPane>
