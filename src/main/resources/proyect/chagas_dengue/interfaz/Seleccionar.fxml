<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="proyect.chagas_dengue.interfaz.SeleccionarController"
      spacing="10" alignment="CENTER" padding="15">

    <!-- Título dinámico -->
    <Label fx:id="lblTitulo"
           text="Seleccionar elemento"
           style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <!-- Lista de elementos -->
    <ListView fx:id="listItems"
              prefWidth="300"
              prefHeight="250"
              style="-fx-background-color: white; -fx-border-color: lightgray;" />

    <!-- Botones inferiores -->
    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="btnCancelar"
                text="Cancelar"
                prefWidth="100"
                style="-fx-background-color: #d9534f; -fx-text-fill: white;" />
        <Button fx:id="btnSeleccionar"
                text="Seleccionar"
                prefWidth="100"
                style="-fx-background-color: #5cb85c; -fx-text-fill: white;" />
    </HBox>
</VBox>
