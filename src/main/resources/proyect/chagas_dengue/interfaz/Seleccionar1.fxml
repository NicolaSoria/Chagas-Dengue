<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="proyect.chagas_dengue.interfaz.SeleccionarController">

    <!-- Título -->
    <Label fx:id="lblTitulo"
           layoutX="200.0" layoutY="30.0"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"
           text="Seleccionar elemento" />

    <!-- Lista de elementos -->
    <ListView fx:id="listItems"
              layoutX="150.0" layoutY="80.0"
              prefHeight="200.0" prefWidth="300.0"
              style="-fx-background-color: white; -fx-border-color: lightgray;" />

    <!-- Botones inferiores -->
    <Button fx:id="btnCancelar"
            layoutX="150.0" layoutY="300.0"
            prefWidth="100.0"
            style="-fx-background-color: #d9534f; -fx-text-fill: white;"
            text="Cancelar" />

    <Button fx:id="btnSeleccionar"
            layoutX="350.0" layoutY="300.0"
            prefWidth="100.0"
            style="-fx-background-color: #5cb85c; -fx-text-fill: white;"
            text="Seleccionar" />

</AnchorPane>



















